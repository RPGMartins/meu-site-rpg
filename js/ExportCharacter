function exportCharacter() 
{
    if(CharacterState.class == undefined && CharacterState.subclass == undefined && CharacterState.race == undefined && CharacterState.subrace == undefined && CharacterState.feats == undefined && CharacterState.background == undefined)
    {
        return;
    }

  const exportData = 
  {
    meta: 
    {
      exportedAt: new Date().toISOString(),
      version: "0.1"
    },

    class: CharacterState.class
      ? {
          name: CharacterState.class.name,
          source: CharacterState.class.source
        }
      : null,

    subclass: CharacterState.subclass
      ? {
          name: CharacterState.subclass.name,
          source: CharacterState.subclass.source
        }
      : null,

    race: CharacterState.race
      ? {
          name: CharacterState.race.name,
          source: CharacterState.race.source
        }
      : null,

    subrace: CharacterState.subrace
      ? {
          name: CharacterState.subrace.name,
          source: CharacterState.subrace.source
        }
      : null,

    background: CharacterState.background ?? null,
    feats: CharacterState.feats ?? []
      
  };

  downloadJson(exportData, "personagem.json");
}
